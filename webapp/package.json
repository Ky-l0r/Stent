{
  "name": "stent-webapp",
  "productName": "Stent",
  "version": "1.2.0",
  "private": true,
  "description": "Stent Web 前端：Electron 壳 + React 渲染进程",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "package": "npm run build && electron-builder --config electron-builder.json --win",
    "package:dir": "npm run build && electron-builder --config electron-builder.json --win --dir"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "author": {
    "name": "Stent"
  }
}
